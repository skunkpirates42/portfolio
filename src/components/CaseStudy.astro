---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
  entry: CollectionEntry<"case-studies">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, role, period, summary, stack } = entry.data;
---

<article class="border-t border-line py-14 first:border-t-0">
  <header>
    <p class="font-mono text-xs tracking-[0.05em] text-faint">{role} &middot; {period}</p>
    <h3 class="mt-3 text-3xl font-bold tracking-[-0.035em] text-balance sm:text-4xl">{title}</h3>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted text-pretty">{summary}</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {
        stack.map((item) => (
          <li class="rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-[11px] text-muted">
            {item}
          </li>
        ))
      }
    </ul>
  </header>

  <div
    class="mt-9 max-w-2xl space-y-5 leading-relaxed text-muted [&_h4]:mt-10 [&_h4]:text-lg [&_h4]:font-semibold [&_h4]:tracking-[-0.02em] [&_h4]:text-ink [&_strong]:font-semibold [&_strong]:text-ink"
  >
    <Content />
  </div>
</article>
