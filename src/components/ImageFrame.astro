---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
}

const { src, alt, width, height, caption } = Astro.props;
---

<figure class="my-8">
  <div
    class="overflow-hidden rounded-2xl border border-line bg-gradient-to-b from-surface-2 to-surface p-3 shadow-[0_40px_90px_-50px_rgba(53,232,210,0.32)] sm:p-4"
  >
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      class="h-auto w-full rounded-xl"
    />
  </div>
  {caption && <figcaption class="mt-3.5 font-mono text-xs leading-relaxed text-faint">{caption}</figcaption>}
</figure>
