---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
}

const { src, alt, width, height, caption } = Astro.props;
---

<figure class="my-8">
  <div class="overflow-hidden rounded-xl border border-line bg-surface-2 p-3 sm:p-5">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      class="h-auto w-full rounded-lg"
    />
  </div>
  {caption && <figcaption class="mt-3 text-sm text-faint">{caption}</figcaption>}
</figure>
