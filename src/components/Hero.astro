---
import { contactLinks } from "../data/links";

const [resume, ...rest] = contactLinks;
---

<section class="mx-auto max-w-5xl px-6 pb-14 pt-24 sm:pt-32">
  <p
    class="inline-flex items-center gap-2.5 rounded-full border border-accent/30 bg-accent/[0.06] px-4 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-accent"
  >
    <span
      class="h-1.5 w-1.5 rounded-full bg-available shadow-[0_0_0_3px_rgba(53,232,210,0.18)]"
      aria-hidden="true"></span>
    Available for senior roles
  </p>

  <h1 class="mt-7 text-5xl font-extrabold tracking-[-0.04em] text-balance sm:text-7xl">
    Peter Ramos
  </h1>

  <p
    class="mt-4 bg-gradient-to-r from-accent to-violet bg-clip-text font-display text-xl font-semibold text-transparent sm:text-2xl"
  >
    Senior Full-Stack Engineer
  </p>

  <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted text-pretty">
    Seven years building product-facing features at scale. Most recently I led frontend
    for the merchant analytics platform at Recharge, the subscription platform behind
    $42B in GMV on Shopify, 20,000 brands and 100M subscribers.
  </p>

  <ul class="mt-9 flex flex-wrap gap-3">
    <li>
      <a
        href={resume.href}
        class="inline-block rounded-xl bg-gradient-to-r from-accent to-[#57F0B4] px-5 py-2.5 text-sm font-semibold text-[#04120F] shadow-[0_8px_34px_-12px_rgba(53,232,210,0.7)] transition-transform hover:-translate-y-0.5"
      >
        {resume.label}
      </a>
    </li>
    {
      rest.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-block rounded-xl border border-line bg-surface px-5 py-2.5 text-sm font-medium transition-colors hover:border-line-strong hover:text-ink"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
