---
const stats = [
  { figure: "7+ years", detail: "building product-facing features at scale" },
  { figure: "20,000+", detail: "merchants reached by the analytics surfaces I led" },
  { figure: "$42B", detail: "GMV flowing through the platform" },
  { figure: "5+ years", detail: "in remote, distributed engineering orgs" },
];
---

<section class="mx-auto max-w-5xl px-6 pb-24">
  <dl class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="relative flex flex-col gap-2 overflow-hidden rounded-2xl border border-line bg-gradient-to-b from-surface-2 to-surface p-6">
          <span
            class="absolute inset-x-5 top-0 h-px bg-gradient-to-r from-transparent via-accent/60 to-transparent"
            aria-hidden="true"
          />
          <dt class="font-display text-3xl font-bold tracking-[-0.035em] tabular-nums">
            {stat.figure}
          </dt>
          <dd class="text-[13px] leading-relaxed text-faint">{stat.detail}</dd>
        </div>
      ))
    }
  </dl>
</section>
