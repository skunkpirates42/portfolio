---
const links = [
  { href: "#work", label: "Work" },
  { href: "#resume", label: "Resume" },
  { href: "#side-work", label: "Side work" },
  { href: "#agentic", label: "Agentic" },
  { href: "#story", label: "Story" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-ground/70 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-5xl items-center gap-4 px-6 py-4" aria-label="Primary">
    <a
      href="/"
      class="hidden shrink-0 font-mono text-xs tracking-[0.2em] text-faint transition-colors hover:text-ink sm:block"
    >
      PR — 2026
    </a>
    <ul class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto sm:justify-end">
      {
        links.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              class="block rounded-full px-3 py-2 text-sm text-muted transition-colors hover:bg-surface hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
